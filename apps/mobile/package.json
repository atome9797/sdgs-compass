{
  "name": "@sdgs-compass/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SDGsコンパス iOS/Android 앱 (Expo SDK 58, React Native, 일본어/한국어 데모)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "types": "expo customize tsconfig.json",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "expo:check": "expo install --check",
    "doctor": "npx --yes expo-doctor@1.21.5",
    "prebuild:check": "expo prebuild --no-install --clean",
    "export": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sdgs-compass/core": "*",
    "@sdgs-compass/data": "*",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.0",
    "jest-expo": "~58.0.12",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  }
}
